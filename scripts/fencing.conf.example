# fencing-setup.py configuration. Copy it to fencing.conf (git ignores *.conf) and edit.
# No password goes in this file: the script asks for it once, hidden, and only when the
# credential Secret does not exist yet.

[bmc]
# The BMC account FAR logs in with. On Dell iDRAC, the Operator role is enough.
username = fencing
# Redfish system resource. This is the Dell iDRAC value; other vendors use other paths
# (if this one answers 404, the script prints the ones the BMC offers).
systems_uri = /redfish/v1/Systems/System.Embedded.1
# iDRACs ship self-signed certificates.
ssl_insecure = true
# How patient the fence agent is with a slow BMC, in seconds. These are ceilings, not fixed
# waits: a fast BMC still returns in a couple of seconds, so a generous value only costs time on
# a slow BMC (which is when you want it) or a dead one. The defaults cover slow iDRACs on busy
# management networks without having to measure every server, so leave them unless you have data.
#   power_timeout: seconds the agent waits for the power state to flip after it sends the off.
#   login_timeout: seconds it waits to get past the BMC login.
# The FAR per-attempt timeout is NOT set here: the script derives it (login + power + 10s margin)
# so it always contains these two. FAR kills the agent at that timeout, so a value shorter than
# the agent's own budget would cut a slow-but-working fence off mid-run.
power_timeout = 60
login_timeout = 20

[nhc]
# How long a worker stays NotReady before its BMC powers it off.
duration = 300s
# How many workers NHC may fence at once. Keep ONE of the two below.
# Goal here is "1 node at a time": NHC acts only while at most 1 worker is unhealthy.
#   max_unhealthy = 1 is exactly that, and it is size-independent (same for 3 or 100 workers).
#   min_healthy (%) must GROW with the worker count: a fixed 51% is "1 at a time" only up to
#   4 workers, and at 5+ it lets 2 fence at once. Percentages that give 1 at a time, by
#   worker count: 3 = 51%, 4 = 60%, 5 = 70%, 6 = 75%, 7-8 = 80%, 9-10 = 85%.
max_unhealthy = 1
# min_healthy = 51%

[hosted]
# Hosted clusters only: <namespace>/<name> of the HostedCluster on the management cluster.
# Checked when you also pass --mgmt-context or --mgmt-kubeconfig.
# hosted_cluster = clusters/my-cluster

[nodes]
# Every worker, exactly as `oc get nodes` names it, and the IP of its BMC.
worker-0.example.com = 10.10.0.10
worker-1.example.com = 10.10.0.11
worker-2.example.com = 10.10.0.12
